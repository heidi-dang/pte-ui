// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                           String                        @id @default(uuid())
  email                        String                        @unique
  password                     String
  name                         String
  role                         String                        @default("student") // "student" | "teacher" | "admin"
  targetScore                  Int                           @default(79)
  currentAvg                   Int                           @default(0)
  status                       String                        @default("Active") // "Active" | "Inactive"
  createdAt                    DateTime                      @default(now())
  studyPlan                    String?                       // JSON string of study plan
  estimatedScores              String?                       // JSON string of estimated subscores
  diagnosticDone               Boolean                       @default(false)
  subTier                      String                        @default("free") // "free" | "premium"
  couponApplied                String?
  subExpiresAt                 DateTime?
  passwordResetTokenHash       String?
  passwordResetExpiresAt       DateTime?
  passwordChangedAt            DateTime?
  lastLoginAt                  DateTime?
  emailVerifiedAt              DateTime?
  sessions                     Session[]
  submissions                  PracticeSubmission[]
  testAttempts                 TestAttempt[]
  progress                     CourseProgress[]
  completions                  LessonCompletion[]
  flashcards                   FlashcardState[]
  notifications                Notification[]
  questionBankItems            QuestionBankItem[]
  audioMetadata                AudioMetadata[]
  playbackConsumptions         PlaybackConsumption[]
  practicePlaybackConsumptions PracticePlaybackConsumption[]
  mediaAssets                  MediaAsset[]
  practiceAttempts             PracticeAttempt[]
  teacherAssignments           TeacherStudentAssignment[]    @relation("TeacherAssignments")
  studentAssignments           TeacherStudentAssignment[]    @relation("StudentAssignments")
  teacherNotes                 TeacherStudentNote[]          @relation("TeacherNotes")
  studentNotes                 TeacherStudentNote[]          @relation("StudentNotes")
  teacherSubmissionReviews  TeacherSubmissionReview[]   @relation("TeacherSubmissionReviews")
  generationBatches        QuestionGenerationBatch[]
}

model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  discountPercent Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model QuestionBankItem {
  id                String    @id @default(cuid())
  taskCode          String
  section           String
  title             String
  instruction       String
  promptText        String
  promptHtml        String?
  audioUrl          String?
  imageUrl          String?
  passageText       String?
  optionsJson       String?
  answerKeyJson     String?
  sampleAnswer      String?
  explanation       String?
  difficulty        String    @default("medium")
  tagsJson          String?
  source            String?
  status            String    @default("draft")
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  generationBatchId String?
  generationSlot    Int?
  contentHash       String?
  contentVersion    Int       @default(1)
  reviewStatus      String    @default("pending_review")
  qualityScore      Int?
  validationJson    String? // Storing as String to match existing patterns like tagsJson
  taskPayloadJson   String? // Storing as String to match existing patterns like tagsJson
  assetStatus       String    @default("not_required")
  aiProvider        String?
  aiModel           String?
  promptVersion     String?
  schemaVersion     String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  publishedAt       DateTime?

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  generationBatch QuestionGenerationBatch? @relation(fields: [generationBatchId], references: [id], onDelete: SetNull)
  candidate QuestionGenerationCandidate? @relation("CandidateBankItem")

  @@unique([taskCode, contentHash])
  @@index([taskCode])
  @@index([section])
  @@index([status])
  @@index([difficulty])
  @@index([generationBatchId])
  @@index([taskCode, reviewStatus])
  @@index([taskCode, status, difficulty])
}

model CustomTask {
  id          String   @id @default(uuid())
  taskCode    String // e.g., "RA", "WE", "ROP"
  title       String
  section     String // "Speaking" | "Writing" | "Reading" | "Listening"
  instruction String
  promptText  String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  authorName  String   @default("System")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String // e.g., "EMAIL_SENT", "SECURITY_BLOCKED", "BACKUP_COMPLETED", "PAYMENT_RECEIVED"
  category  String // e.g., "Email", "Security", "Backup", "Billing"
  message   String
  metadata  String? // JSON string
  timestamp DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PracticeSubmission {
  id                   String                        @id @default(uuid())
  userId               String
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskCode             String // e.g. "RA", "WE", "ROP"
  title                String // Task title
  section              String // "Speaking" | "Writing" | "Reading" | "Listening"
  submittedAt          DateTime                      @default(now())
  status               String                        @default("pending") // "pending" | "graded" | "scoring_failed"
  answerText           String?
  audioUrl             String?
  audioMetadataId      String?                       @unique
  audioMetadata        AudioMetadata?                @relation("PracticeSubmissionAudio", fields: [audioMetadataId], references: [id])
  questionBankItemId   String?
  answerJson           String?
  transcript           String?
  transcriptProvider   String?
  transcriptConfidence Float?
  score                Int? // Overall score out of 90
  fluencyScore         Int? // For speaking tasks
  pronunciationScore   Int? // For speaking tasks
  feedback             String?
  grammarIssues        Int?
  playbackConsumptions PracticePlaybackConsumption[]
  attemptId            String?                       @unique
  attempt              PracticeAttempt?              @relation("PracticeSubmissionAttempt", fields: [attemptId], references: [id], onDelete: SetNull)
  teacherReviews       TeacherSubmissionReview[]     @relation("SubmissionReviews")
}

model TestAttempt {
  id                   String                @id @default(uuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId               String
  title                String
  type                 String // "mini" | "section" | "full"
  date                 String // "YYYY-MM-DD"
  overallScore         Int?
  speakingScore        Int?
  writingScore         Int?
  readingScore         Int?
  listeningScore       Int?
  status               String                @default("In_Progress") // "In_Progress" | "Paused" | "Pending_Grading" | "Grading" | "Grading_Failed" | "Completed"
  currentQuestionIndex Int?                  @default(0)
  secondsRemaining     Int?                  @default(0)
  answersJson          String? // JSON serialized user answers (deprecated/migration fallback)
  questionsJson        String? // JSON serialized question data for resume
  attemptStartedAt     DateTime              @default(now())
  submittedAt          DateTime?
  questionResults      MockQuestionResult[]
  questionSessions     MockQuestionSession[]
  playbackConsumptions PlaybackConsumption[]
  audioMetadata        AudioMetadata[]

  @@index([userId, status])
}

model CourseProgress {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  progress   Int      @default(0) // Percentage
  lastActive DateTime @default(now())
}

model LessonCompletion {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  completedAt DateTime @default(now())
}

model FlashcardState {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId String
  mastered    Boolean @default(false)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  text      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BackgroundJob {
  id             String    @id @default(uuid())
  name           String // Type of job e.g. "speech_grading", "essay_grading", "db_cleanup"
  data           String // JSON string for payload
  status         String    @default("queued") // "queued" | "running" | "completed" | "failed" | "dead_letter"
  result         String? // JSON result output
  error          String?
  scheduledAt    DateTime  @default(now())
  completedAt    DateTime?
  startedAt      DateTime?
  heartbeatAt    DateTime?
  leaseExpiresAt DateTime?
  workerId       String?
  claimToken     String?   @unique
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  idempotencyKey String?   @unique

  @@index([status, scheduledAt])
  @@index([status, leaseExpiresAt])
}

model MockQuestionResult {
  id                   String         @id @default(uuid())
  attemptId            String
  attempt              TestAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId           String
  questionVersion      Int            @default(1)
  questionIndex        Int
  taskType             String
  normalizedResponse   Json // JSON data representing actual selections/answers at time of submission
  audioMetadataId      String?        @unique
  audioMetadata        AudioMetadata? @relation(fields: [audioMetadataId], references: [id], onDelete: SetNull)
  transcript           String?
  transcriptProvider   String?
  transcriptConfidence Float?
  rawDimensions        Json? // JSON of structured subscores
  skillContributions   Json? // JSON of allocated skill points
  finalScore           Int? // Nullable when grading is pending/failed
  feedback             String?
  aiProvider           String?
  aiModel              String?
  promptVersion        String?
  rubricVersion        String?
  scoringPolicyVersion String
  status               String         @default("Pending") // "Pending" | "Grading" | "Completed" | "Failed"
  errorDetails         String?
  gradedAt             DateTime?

  @@unique([attemptId, questionId])
  @@index([attemptId, questionIndex])
}

model MediaAsset {
  id          String   @id @default(uuid())
  purpose     String // "question_prompt_audio" | "student_response_audio" | "question_image"
  objectKey   String   @unique
  mimeType    String
  byteSize    Int
  durationSec Float?
  hash        String?
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model AudioMetadata {
  id                 String              @id @default(uuid())
  objectKey          String              @unique
  mimeType           String
  byteSize           Int
  durationSec        Float?
  hash               String?
  createdAt          DateTime            @default(now())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptId          String?
  attempt            TestAttempt?        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId         String? // Stable question reference
  questionResult     MockQuestionResult?
  practiceSubmission PracticeSubmission? @relation("PracticeSubmissionAudio")
  practiceAttempt    PracticeAttempt?    @relation("PracticeResponseAudio")

  @@index([attemptId, questionId])
}

model PracticeAttempt {
  id                         String    @id @default(uuid())
  userId                     String
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionBankItemId         String?
  questionVersion            Int       @default(1)
  taskCode                   String
  mode                       String    @default("timed")
  status                     String    @default("In_Progress")
  // In_Progress | Submitted | Pending_Transcription | Transcribing | Transcription_Failed
  // Pending_Grading | Grading | Grading_Failed | Completed | Expired
  startedAt                  DateTime  @default(now())
  deadlineAt                 DateTime?
  submittedAt                DateTime?
  questionSnapshotJson       String
  scoringPolicyVersion       String    @default("pte-estimated-v1")
  playbackPolicySnapshotJson String?
  gradingSnapshotJson         String?

  responseAudioId     String?                      @unique
  responseAudio       AudioMetadata?               @relation("PracticeResponseAudio", fields: [responseAudioId], references: [id], onDelete: SetNull)
  submission          PracticeSubmission?          @relation("PracticeSubmissionAttempt")
  playbackConsumption PracticePlaybackConsumption? @relation("AttemptPlayback")

  @@index([userId, status])
  @@index([questionBankItemId, taskCode])
}

model PracticePlaybackConsumption {
  id            String              @id @default(uuid())
  submissionId  String?
  submission    PracticeSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attemptId     String?
  attempt       PracticeAttempt?    @relation("AttemptPlayback", fields: [attemptId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  playedCount   Int                 @default(0)
  firstPlayedAt DateTime?
  lastPlayedAt  DateTime?
  version       Int                 @default(1)

  @@unique([submissionId])
  @@unique([attemptId])
  @@index([userId])
}

model MockQuestionSession {
  id            String      @id @default(uuid())
  attemptId     String
  attempt       TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  questionIndex Int
  startedAt     DateTime    @default(now())
  deadlineAt    DateTime
  submittedAt   DateTime?
  expiredAt     DateTime?
  status        String      @default("In_Progress") // "In_Progress" | "Submitted" | "Expired"

  @@unique([attemptId, questionId])
  @@index([attemptId, questionIndex])
}

model PlaybackConsumption {
  id            String      @id @default(uuid())
  attemptId     String
  attempt       TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  playedCount   Int         @default(0)
  firstPlayedAt DateTime?
  lastPlayedAt  DateTime?
  version       Int         @default(1)

  @@unique([attemptId, questionId])
  @@index([userId, attemptId])
}

model LogEntry {
  id        String   @id @default(uuid())
  level     String // "info" | "warn" | "error"
  message   String
  metadata  String? // JSON context
  timestamp DateTime @default(now())
}

model QuestionGenerationBatch {
  id                String    @id @default(cuid())
  requestKey        String    @unique
  requestedByUserId String
  taskCode          String
  section           String
  topic             String?
  difficulty        String
  requestedCount    Int       @default(10)
  readyCount        Int       @default(0)
  failedCount       Int       @default(0)
  status            String    @default("queued")
  provider          String?
  model             String?
  promptVersion     String
  schemaVersion     String
  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?
  error             String?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  candidates QuestionGenerationCandidate[]
  bankItems  QuestionBankItem[]

  requestedBy User @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([taskCode, status])
}

model QuestionGenerationCandidate {
  id                 String   @id @default(cuid())
  batchId            String
  slotNumber         Int
  status             String   @default("queued")
  attempts           Int      @default(0)
  rawOutputJson      String? // Storing as String for SQLite
  normalizedPayload  String? // Storing as String for SQLite
  validationJson     String? // Storing as String for SQLite
  similarityScore    Float?
  qualityScore       Int?
  failureReason      String?
  questionBankItemId String? @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  batch QuestionGenerationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  questionBankItem QuestionBankItem? @relation("CandidateBankItem", fields: [questionBankItemId], references: [id], onDelete: SetNull)

  @@unique([batchId, slotNumber])
  @@index([batchId, status])
}

model TeacherStudentAssignment {
  id        String   @id @default(uuid())
  teacherId String
  studentId String
  createdAt DateTime @default(now())

  teacher   User     @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
}

model TeacherStudentNote {
  id        String   @id @default(uuid())
  teacherId String
  studentId String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher   User     @relation("TeacherNotes", fields: [teacherId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentNotes", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model TeacherSubmissionReview {
  id           String   @id @default(uuid())
  teacherId    String
  submissionId String
  feedback     String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher      User                @relation("TeacherSubmissionReviews", fields: [teacherId], references: [id], onDelete: Cascade)
  submission   PracticeSubmission  @relation("SubmissionReviews", fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([teacherId, submissionId])
  @@index([submissionId])
}
