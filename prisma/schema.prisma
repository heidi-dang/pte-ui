// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                        String               @id @default(uuid())
  email                     String               @unique
  password                  String
  name                      String
  role                      String               @default("student") // "student" | "teacher" | "admin"
  targetScore               Int                  @default(79)
  currentAvg                Int                  @default(0)
  status                    String               @default("Active") // "Active" | "Inactive"
  createdAt                 DateTime             @default(now())
  studyPlan                 String?              // JSON string of study plan
  estimatedScores           String?              // JSON string of estimated subscores
  diagnosticDone            Boolean              @default(false)
  subTier                   String               @default("free")    // "free" | "premium"
  couponApplied             String?
  subExpiresAt              DateTime?
  passwordResetTokenHash    String?
  passwordResetExpiresAt    DateTime?
  passwordChangedAt         DateTime?
  lastLoginAt               DateTime?
  emailVerifiedAt           DateTime?
  sessions                  Session[]
  submissions               PracticeSubmission[]
  testAttempts              TestAttempt[]
  progress                  CourseProgress[]
  completions               LessonCompletion[]
  flashcards                FlashcardState[]
  notifications             Notification[]
  questionBankItems         QuestionBankItem[]
}

model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  discountPercent Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model QuestionBankItem {
  id              String   @id @default(cuid())
  taskCode        String
  section         String
  title           String
  instruction     String
  promptText      String
  promptHtml      String?
  audioUrl        String?
  imageUrl        String?
  passageText     String?
  optionsJson     String?
  answerKeyJson   String?
  sampleAnswer    String?
  explanation     String?
  difficulty      String   @default("medium")
  tagsJson        String?
  source          String?
  status          String   @default("draft")
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([taskCode])
  @@index([section])
  @@index([status])
  @@index([difficulty])
}

model CustomTask {
  id          String   @id @default(uuid())
  taskCode    String   // e.g., "RA", "WE", "ROP"
  title       String
  section     String   // "Speaking" | "Writing" | "Reading" | "Listening"
  instruction String
  promptText  String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  authorName  String   @default("System")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // e.g., "EMAIL_SENT", "SECURITY_BLOCKED", "BACKUP_COMPLETED", "PAYMENT_RECEIVED"
  category  String   // e.g., "Email", "Security", "Backup", "Billing"
  message   String
  metadata  String?  // JSON string
  timestamp DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PracticeSubmission {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskCode           String   // e.g. "RA", "WE", "ROP"
  title              String   // Task title
  section            String   // "Speaking" | "Writing" | "Reading" | "Listening"
  submittedAt        DateTime @default(now())
  status             String   @default("pending") // "pending" | "graded"
  answerText         String?
  audioUrl           String?
  questionBankItemId String?
  answerJson         String?
  score              Int?     // Overall score out of 90
  fluencyScore       Int?     // For speaking tasks
  pronunciationScore Int?     // For speaking tasks
  feedback           String?
  grammarIssues      Int?
}

model TestAttempt {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId               String
  title                String
  type                 String   // "mini" | "section" | "full"
  date                 String   // "YYYY-MM-DD"
  overallScore         Int
  speakingScore        Int
  writingScore         Int
  readingScore         Int
  listeningScore       Int
  status               String   @default("Completed") // "Completed" | "In Progress" | "Paused"
  currentQuestionIndex Int?     @default(0)
  secondsRemaining     Int?     @default(0)
  answersJson          String?  // JSON serialized user answers
  questionsJson         String?  // JSON serialized question data for resume
}

model CourseProgress {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  progress   Int      @default(0) // Percentage
  lastActive DateTime @default(now())
}

model LessonCompletion {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  completedAt DateTime @default(now())
}

model FlashcardState {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId String
  mastered    Boolean  @default(false)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  text      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BackgroundJob {
  id          String    @id @default(uuid())
  name        String    // Type of job e.g. "speech_grading", "essay_grading", "db_cleanup"
  data        String    // JSON string for payload
  status      String    @default("queued") // "queued" | "running" | "completed" | "failed"
  result      String?   // JSON result output
  error       String?
  scheduledAt DateTime  @default(now())
  completedAt DateTime?
}

model LogEntry {
  id        String   @id @default(uuid())
  level     String   // "info" | "warn" | "error"
  message   String
  metadata  String?  // JSON context
  timestamp DateTime @default(now())
}
