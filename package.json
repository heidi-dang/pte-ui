{
  "name": "pte-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format:check": "bunx prisma format",
    "test": "bun run scripts/smoke/mock-exam-hardening-tests.mjs && bun run scripts/smoke/task-registry-gate.js && bun run scripts/smoke/stt-storage-tests.mjs && bun run scripts/smoke/ai-provider-gate.mjs && bun run scripts/smoke/deepseek-smoke.mjs && bun run scripts/smoke/practice-task-contract-gate.mjs && bun run scripts/smoke/practice-job-chain-tests.mjs && bun run scripts/smoke/practice-playback-concurrency-tests.mjs && bun run scripts/smoke/practice-media-pipeline-tests.mjs && bun run scripts/integration/practice-behavioural-tests.mjs",
    "smoke:practice-submission": "bun run scripts/smoke/practice-submission-smoke.mjs",
    "smoke:upload-auth-boundary": "bun run scripts/smoke/upload-auth-boundary.mjs",
    "regression:question-bank-worker:offline": "REGRESSION_MODE=offline bun run scripts/regression/question-bank-worker-pipeline.mjs",
    "regression:question-bank-worker:live": "REGRESSION_MODE=live DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY:?Required for live mode} bun run scripts/regression/question-bank-worker-pipeline.mjs",
    "seed:admin": "bun run scripts/seed-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@playwright/test": "^1.61.1",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
