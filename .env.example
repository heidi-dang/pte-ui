# .env.example
NODE_ENV=
PORT=
DATABASE_URL="file:./dev.db"
JWT_SECRET=
DEMO_MODE=
SEED_ON_STARTUP=
VITE_DEMO_MODE=
UPLOAD_DIR=
DEEPSEEK_API_KEY=

# === Demo Mode ===
# DEMO_MODE: controls /api/seed endpoint and related demo features.
#   Production must use DEMO_MODE=false (opt-in only).
#   Development defaults to true for convenience.
#
# VITE_DEMO_MODE: client-side flag (Vite exposes VITE_ prefixed vars to the browser).
#   Must be VITE_DEMO_MODE=true to show the frontend role-switching UI.
#   Production must use VITE_DEMO_MODE=false.
#
# SEED_ON_STARTUP: when true, demo accounts and sample data are seeded
#   automatically on server start.
#   Production and test must use SEED_ON_STARTUP=false (opt-in only).
#   Development defaults to true for convenience.

# === Auth Lifecycle ===
# POST /api/auth/forgot-password always returns a generic success message.
# In development (DEMO_MODE=true) the raw resetToken is included in the
# response for testing — production never exposes the token.
#
# POST /api/auth/reset-password hashes the provided token with SHA-256,
# matches it against passwordResetTokenHash, checks passwordResetExpiresAt,
# and performs a one-time reset.
#
# POST /api/auth/change-password requires authentication via JWT and
# validates the current password before accepting a new one.
#
# login updates lastLoginAt on every success.
# Public signup rejects role values other than "student".

# Production defaults (set these explicitly):
#   NODE_ENV=production
#   DEMO_MODE=false
#   SEED_ON_STARTUP=false
#   VITE_DEMO_MODE=false
