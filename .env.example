# .env.example
NODE_ENV=
PORT=
DATABASE_URL="file:./dev.db"
JWT_SECRET=
DEMO_MODE=
SEED_ON_STARTUP=
VITE_DEMO_MODE=
UPLOAD_DIR=
DEEPSEEK_API_KEY=

# DEMO_MODE: when false, /api/seed endpoint is disabled (403).
# VITE_DEMO_MODE: client-side flag (Vite exposes VITE_ prefixed vars to the browser).
#   When false, frontend role-switching UI is hidden.
# SEED_ON_STARTUP: when true, demo accounts and sample data are seeded
#   automatically on server start. Production should set to false.
#
# Production defaults:
#   NODE_ENV=production
#   DEMO_MODE=false
#   SEED_ON_STARTUP=false
#   VITE_DEMO_MODE=false
